# ── Django ────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-secret-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://ironman:ironman@localhost:5432/ironman

# ── Redis / Celery ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ── Object storage (MinIO locally, R2 in prod) ──────────────────────────
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=ironman
AWS_SECRET_ACCESS_KEY=ironman-secret
AWS_STORAGE_BUCKET_NAME=ironman-local

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SIGNING_KEY=dev-jwt-secret-change-me

# ── Sentry ────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Frontend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
